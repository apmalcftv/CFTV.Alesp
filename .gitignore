# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
coverage/

# next.js
/.next/
/out/

# production / build artifacts
/build
build/
dist/

# misc
.DS_Store
*.pem

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
logs/

# temporary files
*.tmp
*.temp
.tmp/
.temp/

# cache
.cache/
*.cache

# env files (nunca versionar segredos reais — .env.example é a exceção)
.env
.env.local
.env.production
.env.development
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sistema operacional
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# VS Code (mantém extensions.json recomendado; ignora config pessoal)
.vscode/*
!.vscode/extensions.json

# dados sensíveis de importação — nunca publicar (endereços/locais reais de
# câmeras dentro do complexo da ALESP); o código do importador continua
# versionado normalmente em scripts/ e src/services/import/
supabase/import/

.vercel
